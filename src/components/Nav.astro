---
import Icon from './Icon.astro';
import { MAIL } from '../config/site';

const path = Astro.url.pathname;
const links = [
  { href: '/#why', label: 'Why this name' },
  { href: '/#buyers', label: 'Buyers' },
  { href: '/#acquire', label: 'Price' },
  { href: '/valuation/', label: 'Valuation' },
  { href: '/transfer/', label: 'Transfer' },
];
---

<header class="site-header">
  <div class="wrap nav-bar">
    <a class="brand" href="/" aria-label="Tinkle Trailers home">
      <span class="mark">TT</span>
      <span class="brand-name">Tinkle<span>Trailers</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to light mode">
        <span class="when-dark"><Icon name="sun" /></span>
        <span class="when-light"><Icon name="moon" /></span>
      </button>
      <a class="btn btn-primary nav-buy" href={MAIL.buy} data-cta="nav_buy">Buy now</a>
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">Open menu</span>
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <div class="wrap mobile-panel" id="mobile-menu" data-menu-panel hidden>
    <nav aria-label="Mobile">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="cta-row">
      <a class="btn btn-primary" href={MAIL.buy} data-cta="menu_buy">Buy now</a>
      <a class="btn btn-ghost" href={MAIL.offer} data-cta="menu_offer">Make offer</a>
      <a class="btn btn-ghost span-2" href={MAIL.contact} data-cta="menu_contact">Contact seller</a>
    </div>
  </div>
</header>
