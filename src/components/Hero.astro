---
import Icon from './Icon.astro';
import { MAIL, SITE } from '../config/site';
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="rise">
      <p class="kicker"><span class="pulse" aria-hidden="true"></span> Premium .com for sale</p>
      <h1 class="domain">TinkleTrailers<span class="domain-tld">.com</span></h1>
      <p class="lede">The category name for mobile trailers, portable restroom trailers, and event logistics. One owner. Direct sale.</p>
      <div class="price-block">
        <p class="price">{SITE.priceLabel}</p>
        <p class="price-meta">USD · one-time · available now · offers reviewed</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href={MAIL.buy} data-cta="hero_buy">Buy now <Icon name="arrow" /></a>
        <a class="btn btn-accent" href="#acquire" data-cta="hero_offer">Make offer</a>
        <a class="btn btn-ghost span-2" href={MAIL.contact} data-cta="hero_contact">Contact seller</a>
      </div>
      <ul class="checks">
        <li><Icon name="shield" /> Escrow protected</li>
        <li><Icon name="lock" /> Direct from owner</li>
        <li><Icon name="clock" /> Transfer in 3–10 days</li>
      </ul>
    </div>

    <figure class="mock rise" style="animation-delay: .08s">
      <div class="mock-bar" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <div class="url-pill">tinkletrailers.com</div>
      </div>
      <div class="mock-body">
        <p class="mock-kicker">Brand preview</p>
        <p class="mock-title">Restroom trailers, on the name people already say.</p>
        <svg class="trailer" viewBox="0 0 360 92" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M28 62h250a14 14 0 0 0 14-14V36H48v26z" />
          <path d="M48 36h34V22h168v14" />
          <path d="M78 36v26M122 36v26M166 36v26M210 36v26" />
          <circle cx="92" cy="70" r="10" />
          <circle cx="246" cy="70" r="10" />
          <path d="M292 50h28l12 12H292" />
          <path d="M18 62h22" />
        </svg>
        <p>Weddings, jobsites, festivals, and relief — one brandable .com instead of a paragraph of explanation.</p>
        <p class="mock-note">Illustration only. This listing sells the domain, not trailer rentals.</p>
      </div>
    </figure>
  </div>
</section>
