---
interface Props {
  name: 'arrow' | 'shield' | 'lock' | 'clock' | 'mail' | 'menu' | 'sun' | 'moon' | 'check' | 'chevron' | 'close';
}
const { name } = Astro.props;
const props = {
  class: 'icon',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.8',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': 'true' as const,
};
---

{name === 'arrow' && (
  <svg {...props}><path d="M5 12h14M13 6l6 6-6 6" /></svg>
)}
{name === 'shield' && (
  <svg {...props}><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" /></svg>
)}
{name === 'lock' && (
  <svg {...props}><path d="M8 11V8a4 4 0 0 1 8 0v3M7 11h10v9H7z" /></svg>
)}
{name === 'clock' && (
  <svg {...props}><circle cx="12" cy="12" r="8" /><path d="M12 8v5l3 2" /></svg>
)}
{name === 'mail' && (
  <svg {...props}><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>
)}
{name === 'menu' && (
  <svg {...props}><path d="M4 7h16M4 12h16M4 17h16" /></svg>
)}
{name === 'sun' && (
  <svg {...props}><circle cx="12" cy="12" r="3.2" /><path d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M18 6l-1.6 1.6M7.6 16.4 6 18" /></svg>
)}
{name === 'moon' && (
  <svg {...props}><path d="M16 3.2A8 8 0 1 0 20.8 14 6.5 6.5 0 0 1 16 3.2z" /></svg>
)}
{name === 'check' && (
  <svg {...props}><path d="M5 12.5 9.2 17 19 7" /></svg>
)}
{name === 'chevron' && (
  <svg {...props}><path d="m6 9 6 6 6-6" /></svg>
)}
{name === 'close' && (
  <svg {...props}><path d="M6 6l12 12M18 6 6 18" /></svg>
)}
