---
import Icon from './Icon.astro';
import { MAIL, SITE } from '../config/site';
---

<section class="close">
  <div class="wrap">
    <p class="kicker">One .com</p>
    <h2>Ready to own TinkleTrailers.com?</h2>
    <p>Asking price {SITE.priceLabel}. Buy it, make an offer, or ask a question. The name is not a rental listing — it is the domain itself.</p>
    <div class="cta-row" style="justify-content: center;">
      <a class="btn btn-primary" href={MAIL.buy} data-cta="close_buy">Buy now <Icon name="arrow" /></a>
      <a class="btn btn-ghost" href="/valuation/" data-cta="close_valuation">Read the valuation</a>
    </div>
  </div>
</section>
