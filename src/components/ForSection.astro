---
import { AUDIENCES } from '../config/site';

const filters = [
  { id: 'all', label: 'All buyers' },
  { id: 'restroom', label: 'Restrooms' },
  { id: 'rental', label: 'Rentals' },
  { id: 'event', label: 'Events' },
  { id: 'jobsite', label: 'Jobsites' },
  { id: 'dealer', label: 'Dealers' },
  { id: 'hospitality', label: 'Hospitality' },
];
---

<section class="section" id="buyers">
  <div class="wrap">
    <div class="section-head center">
      <p class="kicker">Who should buy it</p>
      <h2>Built for the mobile trailer industry.</h2>
      <p class="sub">Filter by the business you run. Same domain, different operator.</p>
    </div>
    <div class="chips" role="toolbar" aria-label="Filter buyer types">
      {filters.map((filter, index) => (
        <button
          class:list={['chip', index === 0 && 'is-on']}
          type="button"
          data-filter={filter.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))}
    </div>
    <div class="grid-3">
      {AUDIENCES.map((item) => (
        <article class="card card-hover" data-audience={item.id}>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
