---
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';
import { MAIL, SITE } from '../config/site';
---

<section class="section" id="acquire">
  <div class="wrap acquire">
    <div class="card">
      <p class="kicker">Premium acquisition</p>
      <p class="price-xl">{SITE.priceLabel}</p>
      <p class="price-meta">USD · one-time · asking price through {SITE.priceValidUntil}</p>
      <p class="sub" style="margin: 1rem 0 1.1rem;">
        Only one registrant can hold TinkleTrailers.com. The asking price is public. Qualified offers are read in the order they arrive. This is not a countdown discount.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={MAIL.buy} data-cta="price_buy">Buy now</a>
        <a class="btn btn-ghost" href={MAIL.offer} data-cta="price_offer">Make offer</a>
        <a class="btn btn-ghost span-2" href={MAIL.contact} data-cta="price_contact"><Icon name="mail" /> Contact seller</a>
      </div>
      <div class="stack" style="margin-top: 1.3rem;">
        <div>
          <p class="mini-title">Secure transfer</p>
          <p>Close through <a href="https://www.escrow.com/" target="_blank" rel="noopener noreferrer">Escrow.com</a>, Dan.com, or your licensed escrow. See the <a href="/transfer/">transfer steps</a>.</p>
        </div>
        <div>
          <p class="mini-title">Fast and private</p>
          <p>Most transfers finish in 3–10 business days. The inquiry goes to {SITE.email} and is not posted on this site.</p>
        </div>
      </div>
    </div>
    <div class="card">
      <h2 style="font-size: 1.6rem; margin-bottom: 0.35rem;">Start the acquisition</h2>
      <p class="price-meta" style="margin-bottom: 1rem;">Opens your email with the details filled in. Nothing is stored on this server.</p>
      <InquiryForm id="acquire-form" source="acquire_form" />
    </div>
  </div>
</section>
