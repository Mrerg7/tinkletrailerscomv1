---
import '../styles/global.css';
import { FAQS, OG_IMAGE, SITE } from '../config/site';
import ExitIntent from '../components/ExitIntent.astro';
import StickyCta from '../components/StickyCta.astro';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  ogType?: string;
  extraGraph?: Record<string, unknown>[];
  includeProduct?: boolean;
  showSticky?: boolean;
  showExit?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  robots = 'index, follow, max-image-preview:large',
  ogType = 'website',
  extraGraph = [],
  includeProduct = false,
  showSticky = true,
  showExit = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    inLanguage: 'en-US',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: `${SITE.url}/`,
    email: SITE.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Phoenix',
      addressRegion: 'AZ',
      addressCountry: 'US',
    },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    datePublished: SITE.published,
    dateModified: SITE.updated,
    inLanguage: 'en-US',
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: OG_IMAGE,
      width: 1200,
      height: 630,
    },
  },
];

if (includeProduct) {
  graph.push(
    {
      '@type': 'Product',
      '@id': `${SITE.url}/#product`,
      name: 'TinkleTrailers.com Premium Domain Name',
      sku: 'tinkletrailers.com',
      description:
        'Premium .com domain for sale. The category name for mobile trailer, portable restroom trailer, and event logistics brands. One-time acquisition at the listed price.',
      category: 'Premium domain name',
      url: `${SITE.url}/`,
      image: {
        '@type': 'ImageObject',
        url: OG_IMAGE,
        width: 1200,
        height: 630,
      },
      brand: { '@type': 'Brand', name: SITE.name },
      offers: {
        '@type': 'Offer',
        url: `${SITE.url}/#acquire`,
        price: SITE.price,
        priceCurrency: 'USD',
        priceValidUntil: SITE.priceValidUntil,
        availability: 'https://schema.org/LimitedAvailability',
        seller: {
          '@type': 'Organization',
          name: SITE.name,
          email: SITE.email,
        },
        shippingDetails: {
          '@type': 'OfferShippingDetails',
          shippingRate: {
            '@type': 'MonetaryAmount',
            value: '0.00',
            currency: 'USD',
          },
          deliveryTime: {
            '@type': 'ShippingDeliveryTime',
            handlingTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 1,
              unitCode: 'DAY',
            },
            transitTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 0,
              unitCode: 'DAY',
            },
          },
          shippingDestination: {
            '@type': 'DefinedRegion',
            addressCountry: 'US',
          },
        },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
          returnMethod: 'https://schema.org/ReturnByMail',
          returnFees: 'https://schema.org/FreeReturn',
          applicableCountry: 'US',
          merchantReturnDays: 0,
        },
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/#faq`,
      mainEntity: FAQS.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  );
}

graph.push(...extraGraph);

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c111c" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <script is:inline>
      try {
        if (localStorage.getItem('tt-theme') === 'light') document.documentElement.classList.add('light');
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-US" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:secure_url" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TinkleTrailers.com premium domain for sale" />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="TinkleTrailers.com premium domain for sale" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    {showSticky && <StickyCta />}
    {showExit && <ExitIntent />}
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
