---
import '../styles/global.css';
import { FAQS, OG_IMAGE, SITE } from '../config/site';
import ExitIntent from '../components/ExitIntent.astro';
import StickyCta from '../components/StickyCta.astro';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  ogType?: string;
  extraGraph?: Record<string, unknown>[];
  includeFaq?: boolean;
  showSticky?: boolean;
  showExit?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  robots = 'index, follow, max-image-preview:large',
  ogType = 'website',
  extraGraph = [],
  includeFaq = false,
  showSticky = true,
  showExit = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    inLanguage: 'en-US',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: `${SITE.url}/`,
    email: SITE.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Phoenix',
      addressRegion: 'AZ',
      addressCountry: 'US',
    },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    datePublished: SITE.published,
    dateModified: SITE.updated,
    inLanguage: 'en-US',
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: OG_IMAGE,
      width: 1200,
      height: 630,
    },
  },
];

if (includeFaq) {
  // NOTE: Product markup intentionally omitted. A domain name for sale has no
  // genuine third-party product reviews to mark up, and Google flags missing
  // review/aggregateRating on Product nodes in Search Console. Inventing
  // self-serving reviews would violate Google's spam policies, so we do not
  // emit @type Product at all. Visible offer details (price, escrow, contact)
  // remain in the page copy. FAQ markup below matches the visible FAQ section.
  graph.push({
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#faq`,
    mainEntity: FAQS.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}

graph.push(...extraGraph);

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c111c" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <script is:inline>
      try {
        if (localStorage.getItem('tt-theme') === 'light') document.documentElement.classList.add('light');
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-US" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:secure_url" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TinkleTrailers.com premium domain for sale" />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="TinkleTrailers.com premium domain for sale" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    {showSticky && <StickyCta />}
    {showExit && <ExitIntent />}
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
