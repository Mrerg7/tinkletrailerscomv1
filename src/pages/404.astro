---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | TinkleTrailers.com"
  description="That page is not on the TinkleTrailers.com domain listing."
  robots="noindex, follow"
  showExit={false}
>
  <Nav />
  <main id="main" class="wrap page-hero" style="padding-bottom: 4rem;">
    <p class="kicker">404</p>
    <h1>This page is not on the listing.</h1>
    <p class="lede" style="margin: 0.8rem 0 1.2rem;">The domain for sale is still TinkleTrailers.com. The address you tried is not.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/">Back to the domain</a>
      <a class="btn btn-ghost" href="/#acquire">See the price</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
